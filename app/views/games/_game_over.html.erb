<% winner = table.winner %>
<div class="overlay" data-controller="dismiss">
  <div class="paper w-full max-w-xl text-center">
    <div class="flex justify-end">
      <button type="button" class="btn-ghost !text-ink/60 hover:!bg-ink/5" data-action="dismiss#remove" aria-label="<%= t("games.round_summary.peek") %>">✕</button>
    </div>
    <div class="hand justify-center" aria-hidden="true">
      <% %w[ n1 n2 n3 n4 n5 n6 n7 ].each_with_index do |code, index| %>
        <%= card_tag code, size: :sm, style: "rotate: #{(index - 3) * 7}deg; translate: 0 #{(index - 3).abs * 3}px; animation-delay: #{index * 80}ms" %>
      <% end %>
    </div>
    <p class="label mt-6"><%= t(".kicker") %></p>
    <h2 class="text-5xl text-ink"><%= winner ? t(".winner", player: table.name_for(winner)) : t(".no_winner") %></h2>
    <% if winner %><p class="mt-2 text-lg text-ink/70"><%= t(".points", points: winner["total"], rounds: table.round) %></p><% end %>

    <ol class="mx-auto mt-6 max-w-sm space-y-2 text-left">
      <% table.standings.each_with_index do |player, index| %>
        <li class="flex items-center gap-3 rounded-xl px-3 py-2 <%= index.zero? ? "bg-gold/25" : "bg-ink/5" %>">
          <span class="w-6 font-display text-xl"><%= index + 1 %>.</span>
          <span class="flex-1 truncate font-extrabold"><%= table.name_for(player) %></span>
          <span class="font-display text-xl tabular-nums"><%= player["total"] %></span>
        </li>
      <% end %>
    </ol>

    <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
      <% if table.game.rematch_code %>
        <%= link_to t(".to_rematch"), game_path(table.game.rematch_code), class: "btn btn-gold" %>
      <% elsif table.seat %>
        <%= button_to t(".rematch"), game_rematch_path(table.game), class: "btn btn-gold w-full" %>
      <% end %>
      <%= link_to t(".home"), root_path, class: "btn btn-cream" %>
    </div>
  </div>
</div>
