<div class="overlay" data-controller="dismiss">
  <div class="paper w-full max-w-3xl">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="label"><%= t(".kicker") %></p>
        <h2 class="text-4xl text-ink"><%= t(".title", round: table.round) %></h2>
      </div>
      <button type="button" class="btn-ghost !text-ink/60 hover:!bg-ink/5" data-action="dismiss#remove" aria-label="<%= t(".peek") %>">✕</button>
    </div>

    <div class="mt-5 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-xs tracking-wider text-ink/50 uppercase">
          <tr>
            <th class="py-2 pr-2"><%= t(".player") %></th>
            <th class="py-2 pr-2"><%= t(".numbers") %></th>
            <th class="py-2 pr-2 text-center">×2</th>
            <th class="py-2 pr-2 text-right"><%= t(".modifiers") %></th>
            <th class="py-2 pr-2 text-right">Jackpot</th>
            <th class="py-2 pr-2 text-right"><%= t(".round_points") %></th>
            <th class="py-2 text-right"><%= t(".total") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink/10">
          <% table.players.reject { |player| player["round_score"].nil? }.sort_by { |player| -player["round_score"]["total"] }.each do |player| %>
            <% score = player["round_score"] %>
            <tr class="<%= "bg-gold/15" if table.me?(player) %>">
              <td class="py-2 pr-2">
                <p class="font-extrabold"><%= table.name_for(player) %></p>
                <div class="hand mt-1 justify-start">
                  <% player["cards"].each do |entry| %><%= card_tag entry["code"], size: :xs, flag: entry["flag"], style: "animation: none" %><% end %>
                </div>
              </td>
              <% if score["busted"] %>
                <td colspan="4" class="py-2 pr-2 font-display text-lg text-ember"><%= t("games.status.busted") %></td>
              <% else %>
                <td class="py-2 pr-2 tabular-nums"><%= score["numbers"] %></td>
                <td class="py-2 pr-2 text-center"><%= score["doubled"] ? "✓" : "–" %></td>
                <td class="py-2 pr-2 text-right tabular-nums">+<%= score["modifiers"] %></td>
                <td class="py-2 pr-2 text-right tabular-nums"><%= score["bonus"].positive? ? "+#{score["bonus"]}" : "–" %></td>
              <% end %>
              <td class="py-2 pr-2 text-right font-display text-xl tabular-nums"><%= score["total"] %></td>
              <td class="py-2 text-right font-display text-xl tabular-nums"><%= player["total"] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if table.log.last&.dig("key") == "tie_break" %>
      <p class="mt-4 rounded-xl bg-gold/20 p-3 text-center font-extrabold"><%= t("log.tie_break") %></p>
    <% end %>

    <div class="mt-6 flex flex-col items-center gap-2">
      <% if table.seat %>
        <%= button_to t(".next_round"), game_rounds_path(table.game), class: "btn btn-gold w-full max-w-sm text-xl" %>
      <% end %>
      <% if table.deadline %>
        <p class="text-sm text-ink/60"><%= t(".auto_start") %> <%= countdown_tag table.deadline, classes: "!bg-ink/10 !text-ink" %></p>
      <% end %>
    </div>
  </div>
</div>
