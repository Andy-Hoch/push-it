<% me = table.me %>
<% best = table.players.filter_map { |player| player.dig("round_score", "total") }.max.to_i %>
<div id="round-summary" class="overlay" data-controller="dismiss reveal" data-reveal-delay-value="<%= table.summary_delay_ms %>">
  <div class="paper w-full max-w-lg !p-4 sm:!p-6">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="label"><%= t(".kicker") %></p>
        <h2 class="text-3xl text-ink sm:text-4xl"><%= t(".title", round: table.round) %></h2>
        <% if (ender = table.round_ender) %>
          <p class="mt-1 text-sm font-bold text-ink/70"><%= log_line ender %></p>
        <% end %>
      </div>
      <button type="button" class="btn-ghost !text-ink/60 hover:!bg-ink/5" data-action="dismiss#remove" aria-label="<%= t(".peek") %>">✕</button>
    </div>

    <table class="mt-4 w-full table-fixed text-sm">
      <colgroup>
        <col class="w-7">
        <col>
        <col class="w-16">
        <col class="w-20">
      </colgroup>
      <thead class="text-xs tracking-wider text-ink/50 uppercase">
        <tr>
          <th class="py-1.5 text-left" aria-label="<%= t(".rank") %>">#</th>
          <th class="py-1.5 text-left"><%= t(".player") %></th>
          <th class="py-1.5 text-right"><%= t(".round_points") %></th>
          <th class="py-1.5 text-right"><%= t(".total") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-ink/10">
        <% table.standings.each_with_index do |player, index| %>
          <% score = player["round_score"] %>
          <tr class="<%= "bg-gold/15" if table.me?(player) %>">
            <td class="py-2 font-display text-lg text-ink/50"><%= index + 1 %></td>
            <td class="py-2">
              <div class="flex min-w-0 items-center gap-1.5">
                <span class="truncate font-extrabold"><%= table.name_for(player) %></span>
                <% if table.ready?(player) %>
                  <span class="shrink-0 font-extrabold text-mint" title="<%= t(".ready") %>" aria-label="<%= t(".ready") %>">✓</span>
                <% end %>
              </div>
              <%= summary_badge player %>
            </td>
            <td class="py-2 text-right font-display text-lg tabular-nums">
              <% if score.nil? %>
                <span class="text-ink/40">–</span>
              <% elsif score["busted"] %>
                <span class="text-ember">0</span>
              <% else %>
                <span class="<%= "text-gold-dark" if best.positive? && score["total"] == best %>">+<%= score["total"] %></span>
              <% end %>
            </td>
            <td class="py-2 text-right">
              <p class="font-display text-xl tabular-nums"><%= player["total"] %></p>
              <div class="progress ml-auto !h-1 w-full !bg-ink/10"><span style="width: <%= table.progress(player) %>%"></span></div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if table.tie_break? %>
      <p class="mt-4 rounded-xl bg-gold/20 p-3 text-center text-sm font-extrabold"><%= t("log.tie_break") %></p>
    <% end %>

    <div class="mt-5 flex flex-col items-center gap-2 text-center">
      <% if me && !me["left"] %>
        <% if table.ready?(me) %>
          <p class="w-full max-w-sm rounded-xl bg-ink/5 px-4 py-3 font-display text-lg"><%= t(".you_are_ready") %></p>
        <% else %>
          <%= button_to t(".next_round"), game_rounds_path(table.game), class: "btn btn-gold w-full text-xl", form: { class: "w-full max-w-sm" } %>
        <% end %>
      <% end %>
      <% if (me.nil? || table.ready?(me)) && (waiting = table.waiting_for).any? %>
        <p class="text-sm text-ink/70"><%= t(".waiting_for", players: waiting.map { |player| table.name_for(player) }.to_sentence) %></p>
      <% end %>
      <% if table.deadline %>
        <p class="text-sm text-ink/60"><%= t(".auto_start") %> <%= countdown_tag table.deadline, classes: "!bg-ink/10 !text-ink" %></p>
      <% end %>
    </div>
  </div>
</div>
