<%= render layout: "layouts/auth_card", locals: { title: t("passwords.edit.title") } do %>
  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :password, t("passwords.edit.password"), class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "field" %>
    </div>
    <div>
      <%= form.label :password_confirmation, t("registrations.new.password_confirmation"), class: "label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "field" %>
    </div>
    <%= form.button t("passwords.edit.submit"), class: "btn btn-gold w-full" %>
  <% end %>
<% end %>
