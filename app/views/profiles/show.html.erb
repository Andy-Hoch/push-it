<main class="mx-auto max-w-4xl space-y-8 px-4 pb-20">
  <% if @profile.nil? %>
    <section class="paper text-center">
      <h1 class="text-4xl text-ink"><%= t(".empty_title") %></h1>
      <p class="mt-3 text-ink/70"><%= t(".empty") %></p>
      <%= link_to t(".play"), root_path, class: "btn btn-gold mt-6" %>
    </section>
  <% else %>
    <section class="felt">
      <div class="flex flex-wrap items-center gap-4">
        <%= avatar_tag @profile.name, classes: "!size-16 !text-3xl" %>
        <div class="min-w-0 flex-1">
          <h1 class="truncate text-4xl"><%= @profile.name %></h1>
          <p class="text-cream/75"><%= @profile.guest? ? t(".guest") : t(".account", email: @profile.user.email_address) %></p>
        </div>
      </div>

      <dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
        <% { games_played: @profile.games_played, games_won: @profile.games_won, win_rate: "#{@profile.win_rate} %",
             flip7_count: @profile.flip7_count, best_round: @profile.best_round, total_points: @profile.total_points }.each do |stat, value| %>
          <div class="seat items-center text-center">
            <dt class="text-xs font-extrabold tracking-wider text-cream/60 uppercase"><%= t(".stats.#{stat}") %></dt>
            <dd class="font-display text-4xl text-gold"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </section>

    <section class="grid gap-6 md:grid-cols-2">
      <%= form_with model: @profile, url: profile_path, method: :patch, class: "paper space-y-4" do |form| %>
        <h2 class="text-2xl text-ink"><%= t(".name_title") %></h2>
        <%= form.text_field :name, maxlength: 24, required: true, class: "field", aria: { label: t("home.show.name") } %>
        <%= form.button t(".save"), class: "btn btn-gold w-full" %>
      <% end %>

      <div class="paper space-y-4">
        <% if @profile.guest? %>
          <h2 class="text-2xl text-ink"><%= t(".save_title") %></h2>
          <p class="text-ink/70"><%= t(".save_hint") %></p>
          <div class="flex flex-col gap-2 sm:flex-row">
            <%= link_to t("layouts.nav.sign_up"), new_registration_path, class: "btn btn-gold flex-1" %>
            <%= link_to t("layouts.nav.sign_in"), new_session_path, class: "btn btn-cream flex-1" %>
          </div>
        <% else %>
          <h2 class="text-2xl text-ink"><%= t(".account_title") %></h2>
          <p class="text-ink/70"><%= t(".account_hint") %></p>
          <%= button_to t("layouts.nav.sign_out"), session_path, method: :delete, class: "btn btn-cream w-full" %>
        <% end %>
      </div>
    </section>

    <% if (open_games = @profile.open_games.includes(seats: :profile)).any? %>
      <section class="panel">
        <h2 class="text-2xl"><%= t("home.show.open_games") %></h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          <% open_games.each do |game| %>
            <li><%= link_to "##{game.code} · #{game.seats.map(&:name).to_sentence}", game_path(game), class: "seat block truncate font-extrabold hover:bg-white/10" %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <section class="panel">
      <h2 class="text-2xl"><%= t(".history") %></h2>
      <% if @finished_games.empty? %>
        <p class="mt-3 text-cream/70"><%= t(".no_history") %></p>
      <% else %>
        <ul class="mt-4 divide-y divide-white/10">
          <% @finished_games.each do |game| %>
            <% mine = game.seat_for(@profile) %>
            <% place = game.seats.sort_by { |seat| -seat.total_score }.index(mine).to_i + 1 %>
            <li class="flex items-center gap-3 py-3">
              <span class="badge <%= game.winner_id == @profile.id ? "badge-stayed" : "badge-active" %>"><%= game.winner_id == @profile.id ? t(".won") : t(".place", place: place) %></span>
              <%= link_to game_path(game), class: "min-w-0 flex-1 truncate hover:underline" do %>
                <%= l(game.finished_at, format: :short) %> · <%= game.seats.map(&:name).to_sentence %>
              <% end %>
              <span class="font-display text-lg"><%= mine&.total_score %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>
</main>
